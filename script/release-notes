#!/usr/bin/env bash
# Print the CHANGELOG.md section for a version, for use as release notes.
#
#   script/release-notes 0.1.0
#
# Fails when the changelog has no section for that version or it is empty.
set -euo pipefail

cd "$(dirname "$0")/.."
version="${1:?usage: script/release-notes <version>}"

notes=$(awk -v version="$version" '
    /^## \[/ {
        if (found) exit
        if (index($0, "## [" version "]") == 1) { found = 1; next }
    }
    found { print }
' CHANGELOG.md)

# Trim leading and trailing blank lines.
notes=$(printf '%s\n' "$notes" | sed -e '/./,$!d' | sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}')

if [ -z "$notes" ]; then
    echo "CHANGELOG.md has no notes for version $version" >&2
    exit 1
fi
printf '%s\n' "$notes"
