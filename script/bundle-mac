#!/usr/bin/env bash
# Build Neon.app and package it as a .dmg and a .zip in dist/.
#
#   script/bundle-mac            universal binary (Apple Silicon + Intel)
#   script/bundle-mac --native   this machine's architecture only, faster
#
# By default the app is ad-hoc signed, which lets it run but is not a Developer
# ID signature: on another Mac, Gatekeeper asks the user to approve it once.
#
# To release, sign with Developer ID and notarize:
#
#   NEON_SIGNING_IDENTITY   a "Developer ID Application: …" identity in the
#                           keychain. Signs the app and the DMG.
#   NEON_NOTARY_PROFILE     a notarytool keychain profile, made with
#                           `xcrun notarytool store-credentials`, or instead
#   NEON_NOTARY_KEY, NEON_NOTARY_KEY_ID, NEON_NOTARY_ISSUER
#                           an App Store Connect API key (.p8 path), its key
#                           ID and issuer ID.
#
# With credentials set, the DMG is notarized and the ticket is stapled to both
# the DMG and the app, so they open offline without a Gatekeeper prompt.
#
# The app embeds Sparkle, which checks the appcast.xml of the latest GitHub
# release for updates; script/appcast writes that file. Updates must carry an
# EdDSA signature from the key whose public half is sparkle_public_key below.
# NEON_SPARKLE_PUBLIC_KEY overrides it, to try updates with a throwaway key.
set -euo pipefail

cd "$(dirname "$0")/.."

native=false
for arg in "$@"; do
    case "$arg" in
        --native) native=true ;;
        *) echo "unknown option: $arg" >&2; exit 2 ;;
    esac
done

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
bundle_id="io.github.michaelmjhhhh.neon"
feed_url="https://github.com/michaelmjhhhh/neon/releases/latest/download/appcast.xml"
# The public half of the update signing key, as `generate_keys -p` prints it.
sparkle_public_key="${NEON_SPARKLE_PUBLIC_KEY:-CG5N19keBF6c86aAmY9Oec8qlv6GMwwhmfBhEeNhkxQ=}"
identity="${NEON_SIGNING_IDENTITY:--}"
dist="dist"
app="$dist/Neon.app"

# Rewrite source paths baked into the binary (panic messages, line tables) so
# they do not reveal the build machine's home directory or checkout location.
export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$HOME=~ --remap-path-prefix=$PWD=."

# A release without the updater would strand its users on that version.
if [ "$identity" != "-" ] && [ -z "$sparkle_public_key" ]; then
    echo "a Developer ID build needs sparkle_public_key for updates" >&2
    exit 1
fi

echo "Building Neon $version"
rm -rf "$dist"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

if $native; then
    cargo build --release --locked -p neon
    cp target/release/neon "$app/Contents/MacOS/neon"
else
    for target in aarch64-apple-darwin x86_64-apple-darwin; do
        cargo build --release --locked -p neon --target "$target"
    done
    lipo -create \
        target/aarch64-apple-darwin/release/neon \
        target/x86_64-apple-darwin/release/neon \
        -output "$app/Contents/MacOS/neon"
fi

cp assets/icon/Neon.icns "$app/Contents/Resources/Neon.icns"

# Without a public key Sparkle refuses every update, so a build without one
# leaves the updater out and the app hides Check for Updates.
updater_keys=""
if [ -n "$sparkle_public_key" ]; then
    sparkle_dir=$(script/fetch-sparkle)
    mkdir -p "$app/Contents/Frameworks"
    ditto "$sparkle_dir/Sparkle.framework" "$app/Contents/Frameworks/Sparkle.framework"
    # The XPC services exist for sandboxed apps; Neon is not sandboxed.
    rm -rf "$app/Contents/Frameworks/Sparkle.framework/XPCServices" \
        "$app/Contents/Frameworks/Sparkle.framework/Versions/B/XPCServices"
    # Sparkle checks the feed's signature as well as the update's, so a
    # tampered feed can't change the release notes or point at an old
    # version, and checks the update before unpacking it.
    updater_keys="
    <key>SUFeedURL</key>
    <string>$feed_url</string>
    <key>SUPublicEDKey</key>
    <string>$sparkle_public_key</string>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>"
else
    echo "No sparkle_public_key: building without the updater"
fi

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Neon</string>
    <key>CFBundleDisplayName</key>
    <string>Neon</string>
    <key>CFBundleIdentifier</key>
    <string>$bundle_id</string>
    <key>CFBundleExecutable</key>
    <string>neon</string>
    <key>CFBundleIconFile</key>
    <string>Neon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$version</string>
    <key>CFBundleVersion</key>
    <string>$version</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>$updater_keys
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>md</string>
                <string>markdown</string>
                <string>mdown</string>
                <string>mkd</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
PLIST
plutil -lint "$app/Contents/Info.plist" >/dev/null

sign() {
    if [ "$identity" = "-" ]; then
        codesign --force --sign - "$1"
    else
        codesign --force --options runtime --timestamp --sign "$identity" "$1"
    fi
}
# Sign nested code first, each part on its own: `codesign --deep` would give
# Sparkle's helpers the app's signing options.
sparkle="$app/Contents/Frameworks/Sparkle.framework"
if [ -d "$sparkle" ]; then
    sign "$sparkle/Versions/B/Autoupdate"
    sign "$sparkle/Versions/B/Updater.app"
    sign "$sparkle"
fi
sign "$app"
codesign --verify --deep --strict "$app"

notary_args=()
if [ -n "${NEON_NOTARY_PROFILE:-}" ]; then
    notary_args=(--keychain-profile "$NEON_NOTARY_PROFILE")
elif [ -n "${NEON_NOTARY_KEY:-}" ]; then
    notary_args=(--key "$NEON_NOTARY_KEY" --key-id "${NEON_NOTARY_KEY_ID:?}" --issuer "${NEON_NOTARY_ISSUER:?}")
fi
if [ ${#notary_args[@]} -gt 0 ] && [ "$identity" = "-" ]; then
    echo "notarization needs NEON_SIGNING_IDENTITY" >&2
    exit 1
fi

echo "Packaging"
zip_name="Neon-$version-macos.zip"
dmg_name="Neon-$version-macos.dmg"

staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT
cp -R "$app" "$staging/"
ln -s /Applications "$staging/Applications"
hdiutil create -quiet -volname "Neon" -srcfolder "$staging" -ov -format UDZO "$dist/$dmg_name"

if [ "$identity" != "-" ]; then
    codesign --force --timestamp --sign "$identity" "$dist/$dmg_name"
fi

# Notarizing the DMG also registers the app inside it, so one submission
# covers both. Stapling attaches the ticket so Gatekeeper needs no network.
if [ ${#notary_args[@]} -gt 0 ]; then
    echo "Notarizing"
    # A team's first submissions can take hours while Apple analyzes them.
    result=$(xcrun notarytool submit "$dist/$dmg_name" "${notary_args[@]}" --wait --timeout 2h \
        --output-format json 2>&1) || true
    echo "$result"
    id=$(printf '%s' "$result" | sed -n 's/.*"id" *: *"\([^"]*\)".*/\1/p' | head -1)
    status=$(printf '%s' "$result" | sed -n 's/.*"status" *: *"\([^"]*\)".*/\1/p' | head -1)
    if [ "$status" != "Accepted" ]; then
        echo "notarization did not succeed: ${status:-no status}" >&2
        if [ -n "$id" ] && [ "$status" = "Invalid" ]; then
            xcrun notarytool log "$id" "${notary_args[@]}" >&2
        fi
        exit 1
    fi
    xcrun stapler staple -q "$dist/$dmg_name"
    xcrun stapler staple -q "$app"
    spctl --assess --type execute "$app"
    spctl --assess --type open --context context:primary-signature "$dist/$dmg_name"
fi

ditto -c -k --keepParent "$app" "$dist/$zip_name"

echo
echo "Done:"
lipo -archs "$app/Contents/MacOS/neon" | sed 's/^/  architectures: /'
ls -lh "$dist" | sed 1d | sed 's/^/  /'
